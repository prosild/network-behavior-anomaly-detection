# deploy/.env로 복사해 값을 채운다(scripts/make_env.py가 무작위 값으로 만든다). 이 파일에는 실제 비밀번호를 넣지 않는다.
POSTGRES_PORT=55432
POSTGRES_SUPERUSER_PASSWORD=change-me
ZEEKAD_OWNER_PASSWORD=change-me
ZEEKAD_WORKER_PASSWORD=change-me
ZEEKAD_API_PASSWORD=change-me
DASHBOARD_RO_PASSWORD=change-me
# 대시보드의 사건 상태 변경 전용(DB 함수 dashboard.transition_incident 실행만 된다)
DASHBOARD_RW_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
# Java 대시보드 자체 DB(zeekad_dashboard) 소유 계정. zeekad DB에는 접속할 수 없다
DASHBOARD_APP_PASSWORD=change-me
# Gemini API 키(에이전트 보고서·판단 모델·RAG 질의 임베딩)
GEMINI_API_KEY=

# 아래는 배포 VM(DD-015, --profile app)에서 쓰는 값이다. 이 PC에서 Postgres만 띄울 때는 기본값 그대로 둔다.
# 관리용(NAT) 카드의 주소. MLflow·대시보드 화면을 이 주소에만 연다. 실습망(host-only) 주소를 넣지 않는다.
MGMT_BIND=127.0.0.1
# 실습망(host-only) 카드 이름(예: ens37, `ip -br addr`로 확인). tcpdump는 이 카드만 캡처한다.
LAB_IFACE=
# 수집 파일을 닫는 주기(초). 짧을수록 빨리 보이지만 파일 경계에서 잘리는 연결이 늘어난다.
ROTATE_SECONDS=300
# VM 안(127.0.0.1)에서만 여는 근거 API 포트, 관리용 주소에 여는 MLflow 화면 포트
API_PORT=8000
MLFLOW_UI_PORT=5000
